{
  "name": "autodelovi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --project unit",
    "e2e": "playwright test --reporter=line",
    "format": "prettier --write .",
    "test:convex": "vitest run --project convex",
    "convex:push": "convex dev --once",
    "seed": "convex run seed:run && convex run seed:createOwner",
    "seed:stats": "convex run seed:stats"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/rate-limiter": "^0.4.0",
    "@convex-dev/resend": "^0.2.8",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-table": "^8.21.3",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.124",
    "gsap": "^3.15.0",
    "next": "16.3.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@edge-runtime/vm": "^5.0.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.2",
    "convex-test": "^0.0.60",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fontkit": "^2.0.4",
    "gltf-validator": "^2.0.0-dev.3.10",
    "jose": "^6.2.12",
    "jsdom": "^30.1.1",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
