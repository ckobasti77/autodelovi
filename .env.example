# Copy to .env.local. `npx convex dev --once` writes the three Convex lines for you.
# Never put a secret in a NEXT_PUBLIC_ variable: every visitor can read those.

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Site URL used for canonical links, OG images and sitemaps
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Same random value as `npx convex env set REVALIDATE_SECRET ...` (cache purge after catalog edits)
REVALIDATE_SECRET=

# Optional contact fallback until Admin → Podešavanja → Firma is filled (empty = hidden)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_VIBER=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=

# Tests only: 3D hero hooks and the ?3d= tier override. Never set in production.
# NEXT_PUBLIC_TEST_HOOKS=1
